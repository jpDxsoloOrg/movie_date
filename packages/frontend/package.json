{
  "name": "@movie-date/frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:check": "npm run codegen && git diff --exit-code -- src/gql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@movie-date/core": "*",
    "amazon-cognito-identity-js": "^6.3.12",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/client-preset": "^4.8.3",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "graphql": "^16.9.0",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1"
  },
  "exports": {
    "./services/*": "./src/services/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./gql": "./src/gql/index.ts",
    "./gql/graphql": "./src/gql/graphql.ts",
    "./screens/*": "./src/screens/*.tsx",
    "./components/filters/filterDraft": "./src/components/filters/filterDraft.ts",
    "./components/*": "./src/components/*.tsx",
    "./src/*": "./src/*",
    "./context/*": "./src/context/*.tsx",
    "./mode/ModeProvider": "./src/mode/ModeProvider.tsx",
    "./mode/*": "./src/mode/*.ts",
    "./install/*": "./src/install/*.ts",
    "./AppRoutes": "./src/AppRoutes.tsx"
  }
}
